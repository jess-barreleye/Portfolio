---
import { Image } from 'astro:assets';

interface GalleryImage {
  image: ImageMetadata;
  caption: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

{images.length > 0 && (
  <div class="gallery">
    {images.map(({ image, caption }) => (
      <figure>
        <Image src={image} alt={caption} width={600} height={400} />
        <figcaption>{caption}</figcaption>
      </figure>
    ))}
  </div>
)}
