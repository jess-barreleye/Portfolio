---
import { Image } from 'astro:assets';

interface Props {
  images: ImageMetadata[];
}

const { images } = Astro.props;

function toCaption(src: string) {
  const filename = src.split('/').pop() ?? '';
  const name = filename.replace(/\.[^./]+$/, '').replace(/[-_]+/g, ' ');
  return name.charAt(0).toUpperCase() + name.slice(1);
}
---

{images.length > 0 && (
  <div class="gallery">
    {images.map((image) => (
      <figure>
        <Image src={image} alt={toCaption(image.src)} width={600} height={400} />
        <figcaption>{toCaption(image.src)}</figcaption>
      </figure>
    ))}
  </div>
)}
