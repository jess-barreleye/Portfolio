---
import { researchTopics, seaRoles, teachingMentoring, hobbies } from '../data/site.js';

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <nav class="nav">
    <a class="nav-brand" href={base}>Jessica Eberle</a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>
    <ul class="nav-links" id="nav-links">
      <li><a href={base}>Home</a></li>
      <li><a href={`${base}about/`}>About</a></li>
      <li class="has-dropdown">
        <a href={`${base}research/`}>Research ▾</a>
        <ul class="dropdown">
          <li><a href={`${base}research/`}>Overview</a></li>
          {researchTopics.map((topic) => (
            <li><a href={`${base}research/${topic.slug}/`}>{topic.title}</a></li>
          ))}
          <li><a href={`${base}research/data-viz/`}>Data Visualization</a></li>
        </ul>
      </li>
      <li class="has-dropdown">
        <a href={`${base}at-sea/`}>At-Sea Operations ▾</a>
        <ul class="dropdown">
          <li><a href={`${base}at-sea/`}>Overview</a></li>
          {seaRoles.map((role) => (
            <li><a href={`${base}at-sea/${role.slug}/`}>{role.title}</a></li>
          ))}
        </ul>
      </li>
      <li class="has-dropdown">
        <a href={`${base}teaching/`}>Teaching &amp; Mentoring ▾</a>
        <ul class="dropdown">
          <li><a href={`${base}teaching/`}>Overview</a></li>
          {teachingMentoring.map((item) => (
            <li><a href={`${base}teaching/${item.slug}/`}>{item.navTitle}</a></li>
          ))}
        </ul>
      </li>
      <li class="has-dropdown">
        <a href={`${base}hobbies/`}>Hobbies ▾</a>
        <ul class="dropdown">
          <li><a href={`${base}hobbies/`}>Overview</a></li>
          {hobbies.map((hobby) => (
            <li><a href={`${base}hobbies/${hobby.slug}/`}>{hobby.title}</a></li>
          ))}
        </ul>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  document.querySelectorAll('.has-dropdown > a').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (window.innerWidth <= 800) {
        event.preventDefault();
        link.parentElement?.classList.toggle('open');
      }
    });
  });
</script>
