---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';

const base = import.meta.env.BASE_URL;
---

<Layout title="About Me">
  <section class="page-header">
    <div class="container">
      <h1>About Me</h1>
      <p>{site.tagline}</p>
    </div>
  </section>

  <section class="section container">
    {site.bio.map((paragraph) => <p>{paragraph}</p>)}
    <div class="card-grid" style="margin-top: 1.5rem;">
      {site.stats.map((stat) => (
        <div class="card" style="text-align: center;">
          <h3 style="font-size: 2rem; margin-bottom: 0;">{stat.value}</h3>
          <p style="margin-top: 0.25rem;">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <h2>Let's Connect!</h2>
    <p class="lead">
      I'd love to hear from you — reach me at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
    </p>
  </section>
</Layout>
