---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site.js';
import gumbySuitPhoto from '../assets/media/about/testing-gumby-suit-mbari-western-flyer.jpg';

const base = import.meta.env.BASE_URL;
---

<Layout title="About Me">
  <section class="page-header">
    <div class="container">
      <h1>About Me</h1>
      <p>{site.tagline}</p>
    </div>
  </section>

  <section class="section container">
    {site.bio.map((paragraph) => <p>{paragraph}</p>)}
    <Image
      src={gumbySuitPhoto}
      alt="Testing a Gumby Suit aboard MBARI's R/V Western Flyer"
      width={900}
      height={600}
      style="border-radius: var(--radius); margin: 1.5rem 0;"
    />
    <div class="card-grid">
      {site.stats.map((stat) => (
        <div class="card" style="text-align: center;">
          <h3 style="font-size: 2rem; margin-bottom: 0;">{stat.value}</h3>
          <p style="margin-top: 0.25rem;">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <h2>Let's Connect!</h2>
    <p class="lead">
      I'd love to hear from you — reach me at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
    </p>
  </section>
</Layout>
