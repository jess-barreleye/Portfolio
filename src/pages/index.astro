---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';

const base = import.meta.env.BASE_URL;
---

<Layout title="Home">
  <section class="hero">
    <div class="hero-inner">
      <div>
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <p>{site.bio[0]}</p>
        <a class="btn" href={`${base}about/`}>About me</a>
        <a class="btn btn-outline" href={`${base}research/`} style="margin-left: 0.75rem;">Explore my work</a>
      </div>
      <img class="hero-photo" src={`${base}images/profile.jpeg`} alt="Portrait of Jessica Eberle" />
    </div>
  </section>

  <section class="section container">
    <h2>What I do</h2>
    <p class="lead">
      A quick overview of the areas I work in — click through for the full story on each.
    </p>
    <div class="card-grid">
      <div class="card">
        <h3>Research</h3>
        <p>Cephalopod biology, marine microbiology, and data visualization projects.</p>
        <a class="card-link" href={`${base}research/`}>View research →</a>
      </div>
      <div class="card">
        <h3>At-Sea Operations</h3>
        <p>Roles spanning science coordination, science management, marine technology, and research.</p>
        <a class="card-link" href={`${base}at-sea/`}>View operations →</a>
      </div>
      <div class="card">
        <h3>Teaching & Mentoring</h3>
        <p>Summer school curriculum design and mentoring students entering ocean STEAM fields.</p>
        <a class="card-link" href={`${base}teaching/`}>View programs →</a>
      </div>
      <div class="card">
        <h3>Hobbies</h3>
        <p>Photography, sailing, diving, and giving back to ocean communities.</p>
        <a class="card-link" href={`${base}hobbies/`}>View hobbies →</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Let's Connect!</h2>
      <p class="lead">
        I'd love to hear from you — reach me at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
      </p>
    </div>
  </section>
</Layout>
