---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';

const base = import.meta.env.BASE_URL;
---

<Layout title="Home">
  <section class="hero">
    <div class="hero-inner">
      <div>
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <p>{site.bio[0]}</p>
        <a class="btn" href={`${base}research/`}>Explore my work</a>
      </div>
      <img class="hero-photo" src={`${base}images/profile.jpeg`} alt="Portrait of Jessica Eberle" />
    </div>
  </section>

  <section class="section container">
    {site.bio.slice(1).map((paragraph) => <p>{paragraph}</p>)}
    <div class="card-grid" style="margin-top: 1.5rem;">
      {site.stats.map((stat) => (
        <div class="card" style="text-align: center;">
          <h3 style="font-size: 2rem; margin-bottom: 0;">{stat.value}</h3>
          <p style="margin-top: 0.25rem;">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <h2>What I do</h2>
    <p class="lead">
      A quick overview of the areas I work in — click through for the full story on each.
    </p>
    <div class="card-grid">
      <div class="card">
        <h3>Research</h3>
        <p>Cephalopod biology, marine microbiology, and other scientific investigations.</p>
        <a class="card-link" href={`${base}research/`}>View research →</a>
      </div>
      <div class="card">
        <h3>At-Sea Operations</h3>
        <p>Roles spanning science coordination, science management, marine technology, and research.</p>
        <a class="card-link" href={`${base}at-sea/`}>View operations →</a>
      </div>
      <div class="card">
        <h3>Data Visualization</h3>
        <p>GIS, 3D digital twins, and data analysis projects from the field and the lab.</p>
        <a class="card-link" href={`${base}data-visualization/`}>View projects →</a>
      </div>
      <div class="card">
        <h3>Photography</h3>
        <p>A personal collection of photos from time at sea and beyond.</p>
        <a class="card-link" href={`${base}photography/`}>View gallery →</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Let's Connect!</h2>
    <p class="lead">
      I'd love to hear from you — reach me at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
    </p>
  </section>
</Layout>
