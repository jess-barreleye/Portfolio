---
import Layout from '../../layouts/Layout.astro';
import { teachingMentoring } from '../../data/site.js';

export function getStaticPaths() {
  return teachingMentoring.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={item.navTitle}>
  <section class="page-header">
    <div class="container">
      <p class="breadcrumb" style="margin-top:0;">
        <a href={`${base}teaching/`}>Teaching &amp; Mentoring</a> / {item.navTitle}
      </p>
      <h1>{item.title}</h1>
      <p>{item.blurb}</p>
    </div>
  </section>

  <section class="section container">
    {item.body.map((paragraph) => <p>{paragraph}</p>)}
  </section>
</Layout>
