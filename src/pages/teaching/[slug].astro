---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import { teachingMentoring } from '../../data/site.js';
import { toCaption } from '../../lib/captions.js';

export function getStaticPaths() {
  return teachingMentoring.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const allImages = import.meta.glob('../../assets/media/teaching/**/*.{jpg,jpeg,png}', { eager: true });

const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
const images = Object.entries(allImages)
  .filter(([path]) => path.includes(`/teaching/${item.slug}/`))
  .map(([path, mod]) => ({ image: mod.default, caption: toCaption(path) }));
---

<Layout title={item.navTitle}>
  <section class="page-header">
    <div class="container">
      <p class="breadcrumb" style="margin-top:0;">
        <a href={`${base}teaching/`}>Teaching &amp; Mentoring</a> / {item.navTitle}
      </p>
      <h1>{item.title}</h1>
      <p>{item.blurb}</p>
    </div>
  </section>

  <section class="section container">
    {item.body.map((paragraph) => <p>{paragraph}</p>)}
    <Gallery images={images} />
  </section>
</Layout>
