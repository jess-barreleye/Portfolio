---
import Layout from '../../../layouts/Layout.astro';
import { dataVizProjects } from '../../../data/site.js';

const base = import.meta.env.BASE_URL;
---

<Layout title="Data Visualization">
  <section class="page-header">
    <div class="container">
      <p class="breadcrumb" style="margin-top:0;"><a href={`${base}research/`}>Research</a> / Data Visualization</p>
      <h1>Data Visualization</h1>
      <p>
        Tools and visualizations I've built to make shipboard and research data easier to explore.
      </p>
    </div>
  </section>

  <section class="section container">
    <div class="card-grid">
      {dataVizProjects.map((project) => (
        <div class="card">
          <h3>{project.title}</h3>
          <p>{project.blurb}</p>
          <a class="card-link" href={`${base}research/data-viz/${project.slug}/`}>Read more →</a>
        </div>
      ))}
    </div>
  </section>
</Layout>
