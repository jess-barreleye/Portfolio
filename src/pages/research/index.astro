---
import Layout from '../../layouts/Layout.astro';
import { researchTopics } from '../../data/site.js';

const base = import.meta.env.BASE_URL;
---

<Layout title="Research">
  <section class="page-header">
    <div class="container">
      <h1>Research</h1>
      <p>
        An overview of my research projects and data work, organized by topic.
      </p>
    </div>
  </section>

  <section class="section container">
    <div class="card-grid">
      {researchTopics.map((topic) => (
        <div class="card">
          <h3>{topic.title}</h3>
          <p>{topic.blurb}</p>
          <a class="card-link" href={`${base}research/${topic.slug}/`}>Read more →</a>
        </div>
      ))}
      <div class="card">
        <h3>Data Visualization</h3>
        <p>GIS, 3D digital twins, and data analysis projects from the field and the lab.</p>
        <a class="card-link" href={`${base}research/data-viz/`}>Read more →</a>
      </div>
    </div>
  </section>
</Layout>
