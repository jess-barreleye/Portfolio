---
import Layout from '../../layouts/Layout.astro';
import { researchTopics } from '../../data/site.js';

export function getStaticPaths() {
  return researchTopics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={topic.title}>
  <section class="page-header">
    <div class="container">
      <p class="breadcrumb" style="margin-top:0;"><a href={`${base}research/`}>Research</a> / {topic.title}</p>
      <h1>{topic.title}</h1>
      <p>{topic.blurb}</p>
    </div>
  </section>

  <section class="section container">
    {topic.body.map((paragraph) => <p>{paragraph}</p>)}
  </section>
</Layout>
