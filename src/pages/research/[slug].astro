---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import { researchTopics } from '../../data/site.js';
import { toCaption } from '../../lib/captions.js';

export function getStaticPaths() {
  return researchTopics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const allImages = import.meta.glob('../../assets/media/research/**/*.{jpg,jpeg,png}', { eager: true });

const { topic } = Astro.props;
const base = import.meta.env.BASE_URL;
const images = Object.entries(allImages)
  .filter(([path]) => path.includes(`/research/${topic.slug}/`))
  .map(([path, mod]) => ({ image: mod.default, caption: toCaption(path) }));
---

<Layout title={topic.title}>
  <section class="page-header">
    <div class="container">
      <p class="breadcrumb" style="margin-top:0;"><a href={`${base}research/`}>Research</a> / {topic.title}</p>
      <h1>{topic.title}</h1>
      <p>{topic.blurb}</p>
    </div>
  </section>

  <section class="section container">
    {topic.body.map((paragraph) => <p>{paragraph}</p>)}
    <Gallery images={images} />
  </section>
</Layout>
