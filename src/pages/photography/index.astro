---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { hobbies } from '../../data/site.js';

const photos = Object.values(
  import.meta.glob('../../assets/photography/*.{png,jpg,jpeg,webp}', { eager: true })
).map((mod) => mod.default);

function toCaption(src) {
  const filename = src.src.split('/').pop() ?? '';
  const name = filename.replace(/\.[^./]+$/, '').replace(/[-_]+/g, ' ');
  return name.charAt(0).toUpperCase() + name.slice(1);
}
---

<Layout title="Photography">
  <section class="page-header">
    <div class="container">
      <h1>Photography</h1>
      <p>
        I rarely go anywhere without my camera. Whether I'm capturing life on the deck during a
        cruise or exploring a new coastline, I love using photography to share the raw beauty of
        our oceans and the day-to-day realities of life at sea.
      </p>
    </div>
  </section>

  <section class="section container">
    {photos.length === 0 ? (
      <p>
        No photos yet — add image files to <code>src/assets/photography/</code> in the repository
        and they'll appear here automatically.
      </p>
    ) : (
      <div class="gallery">
        {photos.map((photo) => (
          <figure>
            <Image src={photo} alt={toCaption(photo)} width={600} height={400} />
            <figcaption>{toCaption(photo)}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>

  <section class="section container">
    <h2>Other Things I Do</h2>
    <div class="card-grid">
      {hobbies.map((hobby) => (
        <div class="card">
          <h3>{hobby.title}</h3>
          <p>{hobby.blurb}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
