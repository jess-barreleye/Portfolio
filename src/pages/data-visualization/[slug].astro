---
import Layout from '../../layouts/Layout.astro';
import { dataVizProjects } from '../../data/site.js';

export function getStaticPaths() {
  return dataVizProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={project.title}>
  <section class="page-header">
    <div class="container">
      <p class="breadcrumb" style="margin-top:0;">
        <a href={`${base}data-visualization/`}>Data Visualization</a> / {project.title}
      </p>
      <h1>{project.title}</h1>
      <p>{project.blurb}</p>
    </div>
  </section>

  <section class="section container">
    {project.body.map((paragraph) => <p>{paragraph}</p>)}
    <p><a class="btn" href={project.repoUrl} target="_blank" rel="noopener noreferrer">View on GitHub →</a></p>
  </section>
</Layout>
