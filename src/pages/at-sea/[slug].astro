---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import { seaRoles } from '../../data/site.js';
import { toCaption } from '../../lib/captions.js';

export function getStaticPaths() {
  return seaRoles.map((role) => ({
    params: { slug: role.slug },
    props: { role },
  }));
}

const allImages = import.meta.glob('../../assets/media/at-sea/**/*.{jpg,jpeg,png}', { eager: true });

const { role } = Astro.props;
const base = import.meta.env.BASE_URL;
const images = Object.entries(allImages)
  .filter(([path]) => path.includes(`/at-sea/${role.slug}/`))
  .map(([path, mod]) => ({ image: mod.default, caption: toCaption(path) }));
---

<Layout title={role.title}>
  <section class="page-header">
    <div class="container">
      <p class="breadcrumb" style="margin-top:0;"><a href={`${base}at-sea/`}>At-Sea Operations</a> / {role.title}</p>
      <h1>{role.title}</h1>
      <p>{role.blurb}</p>
    </div>
  </section>

  <section class="section container">
    {role.body.map((paragraph) => <p>{paragraph}</p>)}
    <Gallery images={images} />
  </section>
</Layout>
