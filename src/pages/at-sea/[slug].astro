---
import Layout from '../../layouts/Layout.astro';
import { seaRoles } from '../../data/site.js';

export function getStaticPaths() {
  return seaRoles.map((role) => ({
    params: { slug: role.slug },
    props: { role },
  }));
}

const { role } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={role.title}>
  <section class="page-header">
    <div class="container">
      <p class="breadcrumb" style="margin-top:0;"><a href={`${base}at-sea/`}>At-Sea Operations</a> / {role.title}</p>
      <h1>{role.title}</h1>
      <p>{role.blurb}</p>
    </div>
  </section>

  <section class="section container">
    {role.body.map((paragraph) => <p>{paragraph}</p>)}
  </section>
</Layout>
